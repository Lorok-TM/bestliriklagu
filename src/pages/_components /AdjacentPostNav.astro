---
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

// Kita gunakan tipe 'any' agar TypeScript mengizinkan format objek apa pun dari index.astro
type Props = {
  prevPost: any;
  nextPost: any;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div class="navigation">
  {prevPost && (
    <a href={getPostUrl(prevPost.id, prevPost.filePath, locale)} class="prev">
      <span>Prev «</span>
      <div>{prevPost.title}</div>
    </a>
  )}
  {nextPost && (
    <a href={getPostUrl(nextPost.id, nextPost.filePath, locale)} class="next">
      <span>» Next</span>
      <div>{nextPost.title}</div>
    </a>
  )}
</div>
