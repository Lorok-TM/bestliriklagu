---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured).slice(0, 10);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured).slice(0, 4);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
<Header />
<main class="site-main" id="main-content">
<section id="hero">
<div class="hero container">
<h1>Lirik Lagu Terbaik</h1>
<p>Best Lyrics adalah situs lirik lagu terlengkap yang menghadirkan keindahan bahasa dari Sabang sampai Merauke.<br>Temukan ribuan lirik lagu Indonesia populer, lagu hits lawas, hingga tembang daerah dari berbagai suku. Mari lestarikan kekayaan musik Indonesia dan jaga tradisi budaya kita dalam satu ketukan nada!</p>
</div>
</section>
<div class="main container">
<div id="primary" class="content-area primary">
    {
      featuredPosts.length > 0 && (
        <section id="featured">
          <div class="wrap-title">{t.home.featured}</div>
          <ul class="multy-posts">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <div class="wrap-title">{t.home.recentPosts}</div>
          <ul class="multy-posts">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

<div class="text-center">
<LinkButton href={getRelativeLocaleUrl(locale, "posts")}>{t.home.allPosts} »</LinkButton>
</div>
</div>

<div id="secondary" itemtype="https://schema.org/WPSideBar" itemscope="itemscope">
<div class="ads-sidebar" id="atContainer-4c291b88073226be09bb970d455fd461"></div>
</div>
</div>
</main>
<Footer />
</Layout>
