---
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  // Tambahi tiping ': number' neng nggone index supoyo TypeScript meneng lan ora ngamuk
  return sortedPosts.map((post, index: number) => ({
    // Iki rute sakti sing ngilangno .md dadi slug murni neng root domain
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: {
      post,
      prevPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
      nextPost: index > 0 ? sortedPosts[index - 1] : null,
    },
  }));
}
