---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

import AdjacentPostNav from "@/components/AdjacentPostNav.astro";

// 1. FUNGSI PENYEDIA RUTE OTOMATIS (getStaticPaths)
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map((post: any, index: number) => {
    const rawPrev = index > 0 ? sortedPosts[index - 1] : null;
    const rawNext = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;

    const prevPost = rawPrev ? {
      id: rawPrev.id,
      title: rawPrev.data.title,
      filePath: rawPrev.filePath
    } : null;

    const nextPost = rawNext ? {
      id: rawNext.id,
      title: rawNext.data.title,
      filePath: rawNext.filePath
    } : null;

    // AMAN & STRING MURNI: Memotong ekstensi berkas (.md / .mdx) tanpa merusak skema [...slug]
    // Fungsi ini mengambil nama depan sebelum tanda titik terakhir dan menjamin outputnya String.
    const cleanSlug = post.id.substring(0, post.id.lastIndexOf('.')) || post.id;

    return {
      // Pastikan slug yang dikirim berupa string tunggal murni, bukan Array atau objek Regex
      params: { slug: cleanSlug }, 
      props: { 
        post, 
        prevPost,
        nextPost
      },
    };
  });
}




// 2. STRUKTUR PROTOKOL TYPE PROPS (Kunci Utama Penghilang Silang Merah)
type Props = {
  post: CollectionEntry<"posts">;
  prevPost: any;
  nextPost: any;
};

// Ambil hak akses properti yang dikirimkan oleh getStaticPaths()
const { post, prevPost = null, nextPost = null } = Astro.props;

const {
  title,
  author,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
} = post.data;

const { Content } = await render(post);

// --- LOGIKA ARTIKEL TERKAIT ---
const allPostsForRelated = await getCollection("posts");
const activePosts = allPostsForRelated.filter((p) => !p.data.draft);

const relatedPosts = activePosts
  .filter((p) => {
    const isNotCurrent = p.id !== post.id;
    const hasTags = Array.isArray(p.data.tags) && Array.isArray(tags);
    const shareTags = hasTags ? p.data.tags.some((tag) => tags.includes(tag)) : false;
    return isNotCurrent && shareTags;
  })
  .slice(0, 3);

// --- LOGIKA SIDEBAR ARTIKEL PILIHAN ---
const featuredPosts = activePosts
  .filter((p) => {
    const isFeatured = p.data.featured === true;
    const isNotCurrent = p.id !== post.id;
    return isFeatured && isNotCurrent;
  })
  .slice(0, 10);
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />
  <Breadcrumb tags={tags} />
  <main class="site-main single" id="main-content">
    <div class="main container">
      <div id="primary" class="content-area primary">
        <article class="post hentry" itemtype="https://schema.org" itemscope="itemscope">
          <header class="entry-header">
            <h1 class="entry-title" itemprop="headline">Lirik Lagu {title}</h1>
            <div class="entry-meta">
              By <span class="posted-by vcard author" itemtype="https://schema.org" itemscope="itemscope" itemprop="author"><a href="/author" class="url fn n" itemprop="url"><span class="author-name" itemprop="name">{author}</span></a></span> / <span class="posted-on"><span class="published" itemprop="datePublished"><Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} timezone={timezone} /></span></span>
            </div>
          </header>
          <div class="entry-content clear" itemprop="text">
            <Content />
          </div>
        </article>
        
        <div class="tags">
          <span>Tags: </span>
          <ul>
            {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} />)}
          </ul>
        </div>
        
        {relatedPosts && relatedPosts.length > 0 && (
          <div class="related-post">
            <div class="related-title">Artikel Terkait:</div>
            <ul>
              {relatedPosts.map((relatedPost) => {
                const cleanRelatedSlug = relatedPost.id.replace(/\.(md|mdx)\$/, "");
                return (
                  <li>
                    <a href={`/${cleanRelatedSlug}/`}>Lirik Lagu {relatedPost.data.title}</a>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        {/* Pemanggilan komponen dengan data dinamis yang sudah tervalidasi aman */}
        <AdjacentPostNav prevPost={prevPost} nextPost={nextPost} />

      </div>

      <div id="secondary" itemtype="https://schema.org" itemscope="itemscope">
        <aside class="sidebar-featured">
          <div class="featured-title">⭐ Artikel Pilihan</div>
          {featuredPosts.length === 0 ? (
            <p class="empty-msg">Tidak ada artikel pilihan.</p>
          ) : (
            <ul>
              {featuredPosts.map((fPost) => {
                const cleanFeaturedSlug = fPost.id.replace(/\.(md|mdx)\$/, "");
                return (
                  <li>
                    <a href={`/${cleanFeaturedSlug}/`}>Lirik Lagu {fPost.data.title}</a>
                  </li>
                );
              })}
            </ul>
          )}
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</PostLayout>
