---
import type { CollectionEntry } from "astro:content";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;

// Amankan data ogImage soko TypeScript error
const ogImage = (data as any).ogImage as string | undefined;

// =========================================================================
// 🔥 SULAP SLUG UTAMA CARD: Pangkas ekstensi .md / .mdx dadi slug root domain
// Awake dhewe ora nggunakake getPostUrl gawan asli sing meksa nambah /posts/
// =========================================================================
const cleanSlug = id.replace(/\.(md|mdx)\$/, "");
const postUrl = `/${cleanSlug}/`;

// Gambar cadangan gabungkan URL post dengan /index.png
const fallbackImage = `${postUrl.replace(/\/$/, "")}/index.png`; 
const finalImage = ogImage || fallbackImage;
---

<li class="li-card">
  {/* Link tak gembok murni langsung neng root domain sak mburine domain plek! */}
  <a href={postUrl}>
    <img src={finalImage} alt={`Cover: ${title}`} class="post-thumb" width="1200" height="630" fetchpriority="high">
    <h2>{title}</h2>
  </a>
  {/* <Datetime {...props} /> */}
  <p>{description}</p>
</li>
