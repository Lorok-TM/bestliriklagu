---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

// Kita jupuk properti 'body' soko Astro.props nggo bahan cuplikan otomatis
const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description: initialDescription, ...props } = data;

// Amankan data ogImage soko TypeScript error
const ogImage = (data as any).ogImage as string | undefined;

// =========================================================================
// 🔥 SULAP UTAMANE URL & TARGET GENERATED IMAGE (IMG SRC)
// =========================================================================
const postUrl = getPostUrl(id, filePath, Astro.currentLocale).replace(/^\/posts/, "");

// KUNCINE: Sanajan URL post wis dadi root domain, manggake rute generator index.png-ne
// TETEP awake dhewe arahno mlebu menyang folder /posts/ bawaan endpoint asline Vercel!
const fallbackImage = `/posts${postUrl.replace(/\/$/, "")}/index.png`; 

const finalImage = ogImage || fallbackImage;

// =========================================================================
// 📥 RAMUAN AUTO-SNIPPET LOWERCASE
// =========================================================================
let finalDescription = initialDescription || "";

if (!finalDescription && body) {
  const cleanBody = body
    .replace(/[#*`_\[\]()]/g, "") // Hapus simbol markdown
    .replace(/^\s*[\r\n]/gm, "")   // Hapus baris kosong
    .trim();
  
  const snippet = cleanBody.length > 100 
    ? cleanBody.substring(0, 100) + "..." 
    : cleanBody;
    
  finalDescription = snippet.toLowerCase(); // Tebas dadi huruf cilik kabeh
}
// =========================================================================
---

<li class="li-card">
  {/* URL saiki wis dijamin sinkron 100% lan langsung manggon neng root domain! */}
  <a href={postUrl}>
    <img src={finalImage} alt={`Cover: ${title}`} class="post-thumb" width="1200" height="630" fetchpriority="high">
    <h2>{title}</h2>
  </a>
  {/* <Datetime {...props} /> */}
  <p>{finalDescription}</p>
</li>
