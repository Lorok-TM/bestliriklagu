---
import type { CollectionEntry } from "astro:content";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

// Kita jupuk properti 'body' soko Astro.props nggo bahan cuplikan otomatis
const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description: initialDescription, ...props } = data;

// Amankan data ogImage soko TypeScript error
const ogImage = (data as any).ogImage as string | undefined;

// SULAP SLUG UTAMA CARD: Pangkas rute /posts/
const cleanSlug = id.replace(/\.(md|mdx)\$/, "");
const postUrl = `/\${cleanSlug}/`;

const fallbackImage = `\({postUrl.replace(/\/\)/, "")}/index.png`; 
const finalImage = ogImage || fallbackImage;

// =========================================================================
// 🔥 RAMUAN SAKTI: AUTO-SNIPPET CARD LOWERCASE
// Yen description kosong, Card jupuk soko isi lirik lan DIBAWAKNO DADI HURUF CILIK KABEH
// =========================================================================
let finalDescription = initialDescription || "";

if (!finalDescription && body) {
  // 1. Resik-resik lirik soko simbol markdown, tanda kurung, utawa baris kosong
  const cleanBody = body
    .replace(/[#*`_\[\]()]/g, "") // Hapus simbol markdown
    .replace(/^\s*[\r\n]/gm, "")   // Hapus baris kosong
    .trim();
  
  // 2. Jupuk 100 karakter pertama wae
  const snippet = cleanBody.length > 100 
    ? cleanBody.substring(0, 100) + "..." 
    : cleanBody;
    
  // 3. TEBAS DADI LOWERCASE (HURUF CILIK KABEH)
  finalDescription = snippet.toLowerCase();
}
// =========================================================================
---

<li class="li-card">
  <a href={postUrl}>
    <img src={finalImage} alt={`Cover: ${title}`} class="post-thumb" width="1200" height="630" fetchpriority="high">
    <h2>{title}</h2>
  </a>
  {/* <Datetime {...props} /> */}
  
  {/* TAMPILNO HASIL CUPLIKAN HURUF CILIK KABEH */}
  <p>{finalDescription}</p>
</li>
