---
import config from "@/config";

type Props = {
  prevPost: any;
  nextPost: any;
};

const { prevPost, nextPost } = Astro.props;

// Fungsi pembantu untuk memotong ekstensi berkas (.md / .mdx) agar menghasilkan slug bersih
const formatSlug = (postId: string) => {
  if (!postId) return "";
  return postId.substring(0, postId.lastIndexOf('.')) || postId;
};
---

<div class="navigation">
  {prevPost && (
    /* Tautan langsung menembak tepat di belakang domain murni */
    <a href={`/${formatSlug(prevPost.id)}/`} class="prev">
      <span>Prev «</span>
      <div>{prevPost.title}</div>
    </a>
  )}
  {nextPost && (
    /* Tautan langsung menembak tepat di belakang domain murni */
    <a href={`/${formatSlug(nextPost.id)}/`} class="next">
      <span>» Next</span>
      <div>{nextPost.title}</div>
    </a>
  )}
</div>
