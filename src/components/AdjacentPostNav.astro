---
// @ts-nocheck
import config from "@/config";

// Kita gunakan tipe any murni agar compiler tidak melakukan sensor pencocokan objek
type Props = {
  prevPost: any;
  nextPost: any;
};

const { prevPost, nextPost } = Astro.props;
---

<div class="navigation">
  {prevPost && (
    /* Menggunakan pemotongan nama file murni langsung menembak ke belakang domain */
    <a href={`/${prevPost.id.substring(0, prevPost.id.lastIndexOf('.')) || prevPost.id}/`} class="prev">
      <span>Prev «</span>
      <div>{prevPost.title}</div>
    </a>
  )}
  {nextPost && (
    /* Menggunakan pemotongan nama file murni langsung menembak ke belakang domain */
    <a href={`/${nextPost.id.substring(0, nextPost.id.lastIndexOf('.')) || nextPost.id}/`} class="next">
      <span>» Next</span>
      <div>{nextPost.title}</div>
    </a>
  )}
</div>
