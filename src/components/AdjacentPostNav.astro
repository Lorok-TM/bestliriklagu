---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div class="navigation">
{prevPost && (
<a href={getPostUrl(prevPost.id, prevPost.filePath, locale)} class="prev">
<span>Prev «</span>
<div>{prevPost.title}</div>
</a>
)}
{nextPost && (
<a href={getPostUrl(nextPost.id, nextPost.filePath, locale)} class="next">
<span>» Next</span>
<div>{nextPost.title}</div>
</a>
)}
</div>
