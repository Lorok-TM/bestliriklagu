---
interface Props {
  prevPost: {
    id: string;
    title: string;
    filePath?: string;
  } | null;
  nextPost: {
    id: string;
    title: string;
    filePath?: string;
  } | null;
}

const { prevPost, nextPost } = Astro.props as Props;
---

<div class="navigation">
  {prevPost && prevPost.id && (
    <a href={`/${prevPost.id.substring(0, prevPost.id.lastIndexOf('.')) || prevPost.id}/`} class="prev">
      <span>Prev «</span>
      <div>Lirik Lagu {prevPost.title}</div>
    </a>
  )}
  {nextPost && nextPost.id && (
    <a href={`/${nextPost.id.substring(0, nextPost.id.lastIndexOf('.')) || nextPost.id}/`} class="next">
      <span>» Next</span>
      <div>Lirik Lagu {nextPost.title}</div>
    </a>
  )}
</div>
