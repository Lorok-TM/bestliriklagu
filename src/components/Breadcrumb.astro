---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";

// 1. Njaga properti gawan AstroPaper kanthi Strict Type
export interface Props {
  breadcrumbList?: Array<{ name: string; path: string }>;
}

const { breadcrumbList } = Astro.props;
const { currentLocale = "id", url } = Astro;
const pathname = url.pathname;

// Fungsi helper kanggo ngowahi teks dadi Title Case ing HTML
const toTitleCase = (str: string) => 
  str.replace(/[-_]/g, " ").replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());

let breadcrumbs: Array<{ name: string; path: string }> = [];

// Yen wis ana properti breadcrumbList gawan, langsung dienggo
if (breadcrumbList && breadcrumbList.length > 0) {
  breadcrumbs = breadcrumbList;
} else {
  // Logika parsing rute standar kanggo kaca umum
  const segments = pathname.split("/").filter(Boolean);
  const isTargetLocale = segments[0] === currentLocale;
  const startIdx = isTargetLocale ? 1 : 0;

  let currentPath = isTargetLocale ? `/${currentLocale}` : "";

  breadcrumbs = segments.slice(startIdx).map((segment) => {
    currentPath += `/${segment}`;
    return {
      name: toTitleCase(segment),
      path: currentPath,
    };
  });
}

// 2. Logika Khusus: Ngowahi urutan kapindho kaca single post dadi Tag Pertama
const allPosts = await getCollection("blog");
const matchingPost = allPosts.find((post) => {
  const postUrl = getRelativeLocaleUrl(currentLocale, `/posts/${post.id || post.slug}`);
  return pathname.endsWith(postUrl) || postUrl.endsWith(pathname);
});

if (matchingPost && matchingPost.data.tags && matchingPost.data.tags.length > 0) {
  const firstTag = matchingPost.data.tags[0];
  const tagPath = getRelativeLocaleUrl(currentLocale, `/tags/${firstTag}`);
  
  // Modifikasi array breadcrumb ing posisi indeks ke-1 (posisi nomer 2)
  if (breadcrumbs.length >= 2) {
    breadcrumbs[1] = {
      name: toTitleCase(firstTag),
      path: tagPath,
    };
  }
}
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol itemscope itemtype="https://schema.org">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org">
      <a itemprop="item" href={getRelativeLocaleUrl(currentLocale, "/")}>
        <span itemprop="name">Home</span>
      </a>
      <meta itemprop="position" content="1" />
      {breadcrumbs.length > 0 && <span aria-hidden="true" class="separator">&#x203A;</span>}
    </li>

    {breadcrumbs.map((crumb, index) => {
      const isLast = index === breadcrumbs.length - 1;
      const position = index + 2; // Amarga 'Home' wis ngisi posisi nomer 1

      return (
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org">
          {!isLast ? (
            <a itemprop="item" href={crumb.path}>
              <span itemprop="name">{crumb.name}</span>
            </a>
          ) : (
            <span itemprop="name" aria-current="page">{crumb.name}</span>
          )}
          <meta itemprop="position" content={String(position)} />
          {!isLast && <span aria-hidden="true" class="separator">&#x203A;</span>}
        </li>
      );
    })}
  </ol>
</nav>

