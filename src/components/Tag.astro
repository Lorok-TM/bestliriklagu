---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

const cleanTagName = tagName
  .replace(/-/g, " ") // ngilangke tanda strip dadi spasi yen ana
  .split(" ")
  .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
  .join(" ");
---

<li>
  <a href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}>
    {cleanTagName}
  </a>
</li>
