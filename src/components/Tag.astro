---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

// Cara nggawe Title Case sing 100% aman kanggo TypeScript Astro v5
const words = tagName.replace(/-/g, " ").split(" ");
const cleanTagName = words.map(w => w.substring(0, 1).toUpperCase() + w.substring(1)).join(" ");
---

<li><a href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}>{cleanTagName}</a></li>
